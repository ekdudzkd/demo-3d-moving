# 복사해서 .env로 사용: cp .env.example .env

# 저장소
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/draw2world.db
RETENTION_HOURS=24

# 업로드
MAX_UPLOAD_MB=10

# 파이프라인 선택
SEGMENTER=grabcut          # grabcut | sam2
GENERATOR=mock             # mock | triposr | sf3d
FACE_BUDGET=50000

# Stable Fast 3D (Stability AI Community License — docs/licenses.md 확인 후에만 활성화)
SF3D_ENABLED=false
SF3D_LICENSE_ACCEPTED=false

# 테스트용 실패 주입 (비우면 정상): oom | timeout | empty
MOCK_FAIL=

# 3단계 GPU (scripts/setup-gpu-env.sh). 가중치 캐시는 WSL이면 ext4 쪽(~/.cache)이 /mnt/c보다 로드가 빠르다
# MODEL_CACHE_DIR=./data/models
# SAM2_CHECKPOINT=facebook/sam2.1-hiera-small
# TRIPOSR_REPO_DIR=~/.cache/d2w/TripoSR
# TRIPOSR_CHUNK_SIZE=65536
