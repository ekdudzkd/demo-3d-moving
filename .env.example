# 복사해서 .env로 사용: cp .env.example .env

# 저장소
DATA_DIR=./data
DATABASE_URL=sqlite:///./data/draw2world.db
RETENTION_HOURS=24

# 업로드
MAX_UPLOAD_MB=10

# 파이프라인 선택
SEGMENTER=grabcut          # grabcut | sam2
GENERATOR=mock             # mock | triposr | sf3d
FACE_BUDGET=50000

# Stable Fast 3D (Stability AI Community License — docs/licenses.md 확인 후에만 활성화)
SF3D_ENABLED=false
SF3D_LICENSE_ACCEPTED=false

# 테스트용 실패 주입 (비우면 정상): oom | timeout | empty
MOCK_FAIL=
